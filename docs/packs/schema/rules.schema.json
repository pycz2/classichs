{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rules.json of a .cardpack (docs/packs/rules.md). Whole numbers only: no fractions anywhere in this file.",
  "type": "object",
  "required": ["format", "limits", "start", "timers", "classes", "rarities", "mechanics", "modes"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 1},
    "limits": {
      "type": "object",
      "required": ["max_mana", "hand", "board", "deck_size", "copies"],
      "additionalProperties": false,
      "properties": {
        "champion_health": {"type": "integer", "minimum": 1, "maximum": 999},
        "max_mana": {"type": "integer", "minimum": 1, "maximum": 99},
        "hand": {"type": "integer", "minimum": 1, "maximum": 99},
        "board": {"type": "integer", "minimum": 1, "maximum": 20},
        "deck_size": {"type": "integer", "minimum": 1, "maximum": 200},
        "copies": {"type": "integer", "minimum": 1, "maximum": 200},
        "copies_by_rarity": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 200}},
        "queue_steps": {"type": "integer", "minimum": 100, "maximum": 100000}
      }
    },
    "start": {
      "type": "object",
      "required": ["hand"],
      "additionalProperties": false,
      "properties": {
        "first_player": {"enum": ["random"]},
        "hand": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 20}},
        "coin": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_]{1,64}$"},
        "mulligan": {"type": "boolean"}
      }
    },
    "fatigue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "first": {"type": "integer", "minimum": 0, "maximum": 99},
        "step": {"type": "integer", "minimum": 0, "maximum": 99}
      }
    },
    "timers": {
      "type": "object",
      "required": ["turn", "mulligan"],
      "additionalProperties": false,
      "properties": {
        "turn": {"type": "integer", "minimum": 10, "maximum": 600},
        "fuse": {"type": "integer", "minimum": 0, "maximum": 600},
        "mulligan": {"type": "integer", "minimum": 5, "maximum": 600},
        "grace": {"type": "integer", "minimum": 0, "maximum": 60},
        "away": {"type": "integer", "minimum": 5, "maximum": 3600}
      }
    },
    "default_power": {"$ref": "#/$defs/id"},
    "classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "champion": {"$ref": "#/$defs/id"},
          "neutral": {"type": "boolean"},
          "playable": {"type": "boolean"}
        }
      }
    },
    "races": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "rarities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "tier"],
        "additionalProperties": false,
        "properties": {"id": {"$ref": "#/$defs/id"}, "tier": {"$ref": "#/$defs/tier"}}
      }
    },
    "no_rarity_tier": {"$ref": "#/$defs/tier"},
    "sets": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "mechanics": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object",
        "required": ["engine"],
        "additionalProperties": false,
        "properties": {"engine": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"}}
      }
    },
    "modes": {
      "type": "object",
      "required": ["constructed"],
      "additionalProperties": false,
      "properties": {
        "constructed": {
          "type": "object",
          "required": ["sets"],
          "additionalProperties": false,
          "properties": {
            "sets": {"$ref": "#/$defs/ids"},
            "class_cards": {"enum": ["own_and_neutral"]},
            "starter_rarities": {"$ref": "#/$defs/ids"},
            "starter_core": {"$ref": "#/$defs/ids"}
          }
        },
        "arena": {
          "type": "object",
          "required": ["sets", "classes", "picks", "offer", "tier_weights", "wins", "losses"],
          "additionalProperties": false,
          "properties": {
            "sets": {"$ref": "#/$defs/ids"},
            "champions_offered": {"type": "integer", "minimum": 1, "maximum": 9},
            "classes": {"$ref": "#/$defs/ids"},
            "picks": {"type": "integer", "minimum": 1, "maximum": 200},
            "offer": {"type": "integer", "minimum": 1, "maximum": 9},
            "tier_weights": {"$ref": "#/$defs/weights"},
            "special_picks": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 200}},
            "special_tier_weights": {"$ref": "#/$defs/weights"},
            "class_weight": {"type": "integer", "minimum": 0, "maximum": 1000},
            "neutral_weight": {"type": "integer", "minimum": 0, "maximum": 1000},
            "copies": {"type": "integer", "minimum": 0, "maximum": 200},
            "wins": {"type": "integer", "minimum": 1, "maximum": 99},
            "losses": {"type": "integer", "minimum": 1, "maximum": 99}
          }
        }
      }
    },
    "ranked": {
      "type": "object",
      "required": ["ranks"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 999}, "stars": {"type": "integer", "minimum": 0, "maximum": 99}}
        },
        "ranks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["rank", "stars"],
            "additionalProperties": false,
            "properties": {
              "rank": {"type": "integer", "minimum": 1, "maximum": 999},
              "stars": {"type": "integer", "minimum": 1, "maximum": 99},
              "loses_stars": {"type": "boolean"},
              "floor": {"type": "boolean"},
              "streak_bonus": {"type": "boolean"},
              "emblem": {"$ref": "#/$defs/emblem"}
            }
          }
        },
        "streak": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"wins": {"type": "integer", "minimum": 2, "maximum": 99}, "bonus_stars": {"type": "integer", "minimum": 0, "maximum": 9}}
        },
        "legend": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "after_rank": {"type": "integer", "minimum": 1, "maximum": 999},
            "keep_for_season": {"type": "boolean"},
            "numbered_top": {"type": "integer", "minimum": 0, "maximum": 10000000},
            "emblem": {"$ref": "#/$defs/emblem"}
          }
        },
        "season": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "length": {"enum": ["month"]},
            "reset": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to_rank": {"type": "integer", "minimum": 1, "maximum": 999},
                "stars_per_rank_above": {"type": "integer", "minimum": 0, "maximum": 9},
                "legend_counts_as": {"type": "integer", "minimum": 0, "maximum": 999}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$"},
    "ids": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/id"}},
    "tier": {"enum": ["common", "rare", "epic", "legendary"]},
    "weights": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/tier"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000}
    },
    "emblem": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "required": ["card"], "additionalProperties": false, "properties": {"card": {"$ref": "#/$defs/id"}}},
        {
          "type": "object",
          "required": ["image"],
          "additionalProperties": false,
          "properties": {"image": {"type": "string", "pattern": "^ui/[A-Za-z0-9_][A-Za-z0-9_.-]*\\.(png|jpg|jpeg|webp)$"}}
        }
      ]
    }
  }
}
