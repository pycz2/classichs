{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tutorial.json of a .cardpack: the tutorial's missions in order, their intro pages, the unlock rule, the hints",
  "type": "object",
  "required": ["missions"],
  "additionalProperties": false,
  "properties": {
    "about": {"type": "string"},
    "unlock": {"enum": ["in_order", "all"]},
    "effect": {"$ref": "#/$defs/effect"},
    "missions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 999},
          "effect": {"$ref": "#/$defs/effect"},
          "intro": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/page"}}
        }
      }
    },
    "hints": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
      "additionalProperties": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/condition"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$"},
    "text": {"type": "string", "pattern": "^[a-z0-9_.]{1,64}$"},
    "point": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -2000, "maximum": 4000}},
    "color": {"type": "string", "pattern": "^[0-9a-f]{6}([0-9a-f]{2})?$"},
    "effect": {
      "anyOf": [
        {"type": "null"},
        {"enum": ["none", "embers", "rain", "snow"]},
        {
          "type": "object",
          "required": ["effect"],
          "additionalProperties": false,
          "properties": {
            "effect": {"enum": ["none", "embers", "rain", "snow"]},
            "intensity": {"type": "number", "minimum": 0.1, "maximum": 3},
            "colors": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/color"}}
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "required": ["title", "text"],
      "additionalProperties": false,
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "text": {"$ref": "#/$defs/text"},
        "effect": {"$ref": "#/$defs/effect"},
        "items": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "item": {
      "anyOf": [
        {"type": "object", "required": ["card", "at"], "additionalProperties": false,
          "properties": {"card": {"$ref": "#/$defs/id"}, "at": {"$ref": "#/$defs/point"}, "scale": {"type": "number", "minimum": 0.2, "maximum": 4}}},
        {"type": "object", "required": ["hero", "at"], "additionalProperties": false,
          "properties": {"hero": {"$ref": "#/$defs/id"}, "at": {"$ref": "#/$defs/point"}, "health": {"type": "integer", "minimum": 0, "maximum": 999}}},
        {"type": "object", "required": ["mana", "at"], "additionalProperties": false,
          "properties": {"mana": {"type": "integer", "minimum": 0, "maximum": 10}, "at": {"$ref": "#/$defs/point"}}},
        {"type": "object", "required": ["picture", "at"], "additionalProperties": false,
          "properties": {"picture": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*\\.(png|jpg|jpeg|webp)$"},
            "at": {"$ref": "#/$defs/point"}, "size": {"$ref": "#/$defs/point"}}},
        {"type": "object", "required": ["note", "box"], "additionalProperties": false,
          "properties": {
            "note": {"$ref": "#/$defs/text"},
            "box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -2000, "maximum": 4000}},
            "to": {"anyOf": [
              {"$ref": "#/$defs/point"},
              {"type": "object", "required": ["card", "part"], "additionalProperties": false,
                "properties": {"card": {"type": "integer", "minimum": 0, "maximum": 29},
                  "part": {"enum": ["cost", "attack", "health", "text", "text_l", "text_r", "top"]}}}
            ]}
          }},
        {"type": "object", "required": ["attack"], "additionalProperties": false,
          "properties": {"attack": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/point"}}, "blocked": {"type": "boolean"}}},
        {"type": "object", "required": ["big", "at"], "additionalProperties": false,
          "properties": {"big": {"type": "string", "maxLength": 8}, "at": {"$ref": "#/$defs/point"}, "color": {"$ref": "#/$defs/color"}}}
      ]
    },
    "condition": {
      "type": "object",
      "required": ["if"],
      "additionalProperties": false,
      "properties": {
        "if": {"enum": ["always", "can_play", "can_attack", "can_use_power", "only_end_turn", "mana", "in_hand", "on_board",
          "enemy_minions", "enemy_weapon"]},
        "at_least": {"type": "integer", "minimum": 0, "maximum": 99},
        "cards": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/id"}},
        "keyword": {"$ref": "#/$defs/id"}
      }
    }
  }
}
