{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "layout/<lang>.json of a .cardpack: hand-tuned card text layout, card id -> how to draw the name and text",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[A-Za-z0-9_]{1,64}$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "integer",
        "minimum": 1,
        "maximum": 99
      },
      "text": {
        "type": "integer",
        "minimum": 1,
        "maximum": 99
      },
      "lines": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 200
        }
      },
      "valign": {
        "enum": [
          "top",
          "center"
        ]
      },
      "dy": {
        "type": "integer",
        "minimum": -200,
        "maximum": 200
      }
    }
  }
}
