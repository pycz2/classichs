{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cards.json of a .cardpack (docs/packs/cards.md)",
  "type": "array",
  "maxItems": 5000,
  "items": {
    "type": "object",
    "required": ["id", "type", "class"],
    "additionalProperties": false,
    "properties": {
      "id": {"$ref": "#/$defs/id"},
      "type": {"enum": ["MINION", "SPELL", "WEAPON", "CHAMPION", "POWER"]},
      "class": {"$ref": "#/$defs/id"},
      "rarity": {"$ref": "#/$defs/id"},
      "set": {"$ref": "#/$defs/id"},
      "collectible": {"type": "boolean"},
      "cost": {"$ref": "#/$defs/n"},
      "attack": {"$ref": "#/$defs/n"},
      "health": {"$ref": "#/$defs/n"},
      "durability": {"$ref": "#/$defs/n"},
      "race": {"$ref": "#/$defs/id"},
      "keywords": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "spell_power": {"$ref": "#/$defs/n"},
      "mana_lock": {"$ref": "#/$defs/n"},
      "unique": {"type": "boolean"},
      "power": {"$ref": "#/$defs/id"},
      "code_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
      "legacy_code_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
      "script": {"type": "string", "pattern": "^scripts/[A-Za-z0-9_][A-Za-z0-9_./-]*\\.lua#[A-Za-z0-9_]{1,64}$"},
      "fx": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element": {"$ref": "#/$defs/fx"},
          "cast": {"$ref": "#/$defs/fx"},
          "hit": {"$ref": "#/$defs/fx"},
          "play": {"$ref": "#/$defs/fx"},
          "death": {"$ref": "#/$defs/fx"}
        }
      },
      "sounds": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"play": {"$ref": "#/$defs/sound"}, "attack": {"$ref": "#/$defs/sound"}, "death": {"$ref": "#/$defs/sound"}}
      },
      "voice": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$"},
    "n": {"type": "integer", "minimum": 0, "maximum": 999},
    "fx": {"type": "string", "pattern": "^[a-z0-9_]{1,32}$"},
    "sound": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"}
  }
}
