extends TestCase


static func root() -> Window:
	return (Engine.get_main_loop() as SceneTree).root


func _setup() -> void:
	Settings.path = "user://test_settings_view.json"
	Profile.path = "user://test_profile_settings.json"
	Settings.load_settings()
	Settings.save()  # not a first run (that one asks for the language)


func _teardown() -> void:
	Locale.set_language("en")
	for p in [Settings.path, Profile.path]:
		DirAccess.remove_absolute(p)
	Settings.path = "user://test_runner_settings.json"
	Profile.path = Profile.DEFAULT_PATH
	Settings.load_settings()
	Settings.data.language = "en"
	Settings.apply()


func _settings() -> SettingsView:
	var s := SettingsView.new()
	root().add_child(s)
	return s


func test_menu_opens_settings_and_back() -> void:
	_setup()
	var m: Node = load("res://ui/main.tscn").instantiate()
	root().add_child(m)
	(m.screen.find_child("Settings", true, false) as Button).pressed.emit()
	check(m.screen is SettingsView, "settings screen")
	(m.screen.find_child("Back", true, false) as Button).pressed.emit()
	check(m.screen is MainMenu, "back to menu")
	m.free()
	_teardown()


## The FPS counter: off by default; the toggle saves it and the overlay over every screen follows at once.
func test_fps_counter_toggle() -> void:
	_setup()
	eq(Settings.data.fps, false, "off by default")
	var m: Node = load("res://ui/main.tscn").instantiate()
	root().add_child(m)
	var fps := m.find_child("FpsCounter", false, false) as FpsCounter
	check(fps != null, "main owns the counter")
	fps._process(0.0)
	check(not fps.visible, "hidden while off")
	eq(fps.label.mouse_filter, Control.MOUSE_FILTER_IGNORE, "takes no clicks")
	(m.screen.find_child("Settings", true, false) as Button).pressed.emit()
	(m.screen.find_child("Fps", true, false) as CheckButton).button_pressed = true
	fps._process(0.0)
	check(fps.visible, "shown at once")
	check(fps.label.text.ends_with(" FPS"), "frames per second: " + fps.label.text)
	Settings.load_settings()
	eq(Settings.data.fps, true, "saved")
	(m.screen.find_child("Fps", true, false) as CheckButton).button_pressed = false
	fps._process(0.0)
	check(not fps.visible, "hidden again")
	(m.screen.find_child("Back", true, false) as Button).pressed.emit()
	check(m.find_child("FpsCounter", false, false) == fps, "stays across screens")
	m.free()
	_teardown()


func test_language_switch_saves_and_rebuilds() -> void:
	_setup()
	var s := _settings()
	s.set_language("ru")
	eq(Settings.data.language, "ru", "stored")
	eq(TranslationServer.get_locale(), "ru", "applied")
	var title := s.find_child("Title", true, false) as Label
	eq(title.text, "Настройки", "own texts rebuilt in Russian")
	Settings.load_settings()
	eq(Settings.data.language, "ru", "saved to file")
	s.free()
	_teardown()


func test_volume_shake_and_tts() -> void:
	_setup()
	var s := _settings()
	(s.find_child("Music", true, false) as HSlider).value = 0.0
	eq(Settings.data.music, 0.0, "music 0")
	check(AudioServer.is_bus_mute(AudioServer.get_bus_index("Music")), "music bus muted")
	(s.find_child("Shake", true, false) as CheckButton).button_pressed = false
	eq(Match.shake_enabled, false, "shake off")
	check(s.find_child("Tts", true, false) == null and s.find_child("voice", true, false) == null, "no speech settings any more")
	Settings.load_settings()
	eq(Settings.data.shake, false, "saved")
	s.free()
	_teardown()


## The global settings: language, volumes, card back, animation speed, shake, fullscreen; the
## music and art sets are a game's (the library), the name is asked before code play, the
## servers are the connections; no Debug tools outside a game.
func test_global_settings_only() -> void:
	_setup()
	var s := _settings()
	for n in ["Language", "Music", "Sounds", "CardBack", "AnimSpeed", "Shake", "Fullscreen", "Fps", "Back"]:
		check(s.find_child(n, true, false) != null, n + " in the settings")
	for n in ["MusicSet", "ArtSet", "Name", "Servers", "DebugTools"]:
		check(s.find_child(n, true, false) == null, n + " not in the settings")
	s.free()
	var g := GamesView.new()
	root().add_child(g)
	var pick := g.find_child("MusicSet", true, false) as OptionButton
	eq(pick.item_count, 2, "a game's music sets in the library: generated and open")
	eq(Packs.choice(Packs.active(), "music"), "generated", "generated by default")
	pick.select(1)
	pick.item_selected.emit(1)
	Settings.load_settings()
	eq(Packs.choice(Packs.active(), "music"), "open", "saved for this game")
	Packs.set_choice(Packs.active(), "music", "generated")
	g.free()
	_teardown()


## The name is asked right before code play (it starts as the last one) and kept for the next time.
func test_name_is_asked_before_code_play() -> void:
	_setup()
	Profile.save_name("Thrall")
	var pair := FakeRtc.fake_pair()
	var o := OnlineView.new()
	o.transport_factory = func(): return pair[0]
	root().add_child(o)
	eq([o.stage, o.name_edit.text], ["name", "Thrall"], "the name first, the last one in it")
	o.name_edit.text = "  Jaina  "
	o.choose_kind("game")
	o.chooser.rows[0].pressed.emit()
	o.host_game()
	eq(Profile.load_name(), "Jaina", "kept")
	o.free()
	_teardown()


func test_match_settings_relabels_static_buttons() -> void:
	_setup()
	var v := MatchView.new()
	root().add_child(v)
	var m := H.scene({"hero": "HERO_08"}, {"hero": "HERO_01"}, 0, [false, true])
	v.bind(m)
	(v.find_child("SettingsButton", true, false) as Button).pressed.emit()
	var s := v.find_child("SettingsView", true, false) as SettingsView
	check(s != null, "settings overlay")
	s.set_language("ru")
	eq((v.find_child("EndTurn", true, false) as Button).text, "Конец хода", "end turn relabeled")
	var texts := func() -> Array:
		return v.find_children("*", "Label", true, false).map(func(l): return l.text) + \
			v.find_children("*", "Button", true, false).map(func(b): return b.text)
	check(texts.call().has("– Ваша колода"), "tracker header relabeled")
	eq((v.find_child("HistoryTitle", true, false) as Label).text, "История", "history title relabeled")
	check(texts.call().has("Бот"), "bot name relabeled")
	s.set_language("en")
	check(texts.call().has("Bot"), "bot name back in English")
	(s.find_child("Back", true, false) as Button).pressed.emit()
	check(not is_instance_valid(s) or s.is_queued_for_deletion(), "overlay closed")
	v.free()
	_teardown()


func test_concede_button_becomes_menu_after_game_over() -> void:
	var v := MatchView.new()
	root().add_child(v)
	var m := H.scene({"hero": "HERO_08"}, {"hero": "HERO_01"}, 0, [false, false])
	v.bind(m)
	m.submit({"type": "concede", "player": 1})
	v.refresh()
	eq((v.find_child("Concede", true, false) as Button).text, "Menu", "menu after game over")
	v.free()
