{
  "_doc": "Voice cast for tools/tts/gen_voice.py. 'styles' are Chatterbox settings; 'effects' are ffmpeg filters; a voice has either 'ref' (a Kokoro speaker that reads 'ref_text' once to make the reference clip) or 'base' (another voice whose clip it reuses).",
  "cross_lang_cfg_weight": 0.0,
  "styles": {
    "neutral":  {"exaggeration": 0.5,  "cfg_weight": 0.5,  "temperature": 0.8},
    "heroic":   {"exaggeration": 0.7,  "cfg_weight": 0.4,  "temperature": 0.8},
    "cheerful": {"exaggeration": 0.85, "cfg_weight": 0.5,  "temperature": 0.85},
    "gruff":    {"exaggeration": 0.6,  "cfg_weight": 0.3,  "temperature": 0.8, "tempo": 0.95},
    "menacing": {"exaggeration": 0.75, "cfg_weight": 0.25, "temperature": 0.8, "tempo": 0.92},
    "eerie":    {"exaggeration": 0.35, "cfg_weight": 0.3,  "temperature": 0.75, "tempo": 0.9},
    "calm":     {"exaggeration": 0.4,  "cfg_weight": 0.5,  "temperature": 0.75}
  },
  "effects": {
    "deep":   "rubberband=pitch=0.82",
    "deeper": "rubberband=pitch=0.7",
    "high":   "rubberband=pitch=1.4",
    "hall":   "aecho=0.8:0.85:40|70|110|160:0.35|0.28|0.2|0.12",
    "cave":   "aecho=0.8:0.9:60|120|200|300:0.4|0.3|0.22|0.15",
    "echo":   "aecho=0.8:0.75:220|440:0.45|0.25",
    "growl":  "acrusher=bits=6:mix=0.25,asoftclip=type=atan",
    "robot":  "afftfilt=real='hypot(re,im)*sin(0)':imag='hypot(re,im)*cos(0)':win_size=512:overlap=0.75,acrusher=bits=10:mix=0.2",
    "ghost":  "chorus=0.6:0.9:50|60:0.4|0.32:0.25|0.4:2|1.3"
  },
  "voices": {
    "m_hero":    {"gender": "m", "ref": "am_michael", "style": "heroic",   "fx": [],
                  "ref_text": "Stand fast, brothers! The enemy is at the gates, and we will hold this line until the last light fades."},
    "m_gruff":   {"gender": "m", "ref": "am_fenrir",  "style": "gruff",    "fx": [],
                  "ref_text": "Get out of my way. I have crushed bigger fools than you, and I am still hungry for a fight."},
    "m_old":     {"gender": "m", "ref": "bm_george",  "style": "calm",     "fx": [],
                  "ref_text": "Patience, young one. The arcane rewards those who listen, and punishes those who rush ahead."},
    "m_rogue":   {"gender": "m", "ref": "am_puck",    "style": "cheerful", "fx": [],
                  "ref_text": "Ha! Did you see that? Quick hands, quicker feet. Nobody catches me, not today, not ever!"},
    "f_hero":    {"gender": "f", "ref": "af_heart",   "style": "heroic",   "fx": [],
                  "ref_text": "For the light and for our people! Follow me, and we will drive the darkness from these lands."},
    "f_mystic":  {"gender": "f", "ref": "af_nicole",  "style": "eerie",    "fx": [],
                  "ref_text": "Can you hear them whisper? The shadows remember every name, and soon they will remember yours."},
    "f_noble":   {"gender": "f", "ref": "bf_emma",    "style": "calm",     "fx": [],
                  "ref_text": "Be at peace. The forest and the stars watch over us, and nothing here will come to harm."},
    "f_bright":  {"gender": "f", "ref": "af_bella",   "style": "cheerful", "fx": [],
                  "ref_text": "Oh, this is going to be fun! Let's go, let's go, I have been waiting all day for this!"},

    "giant":     {"gender": "m", "base": "m_gruff",  "style": "gruff",    "fx": ["deep", "hall"]},
    "beast":     {"gender": "m", "base": "m_gruff",  "style": "gruff",    "fx": ["deeper", "hall"]},
    "demon":     {"gender": "m", "base": "m_gruff",  "style": "menacing", "fx": ["deeper", "growl", "cave"]},
    "dragon":    {"gender": "m", "base": "m_hero",   "style": "heroic",   "fx": ["deep", "cave"]},
    "dragon_f":  {"gender": "f", "base": "f_noble",  "style": "calm",     "fx": ["deep", "cave"]},
    "elemental": {"gender": "m", "base": "m_gruff",  "style": "menacing", "fx": ["deep", "ghost", "cave"]},
    "mech":      {"gender": "m", "base": "m_rogue",  "style": "neutral",  "fx": ["robot"]},
    "spirit_m":  {"gender": "m", "base": "m_old",    "style": "eerie",    "fx": ["ghost", "echo"]},
    "spirit_f":  {"gender": "f", "base": "f_mystic", "style": "eerie",    "fx": ["ghost", "echo"]},
    "small":     {"gender": "m", "base": "m_rogue",  "style": "cheerful", "fx": ["high"]},
    "small_f":   {"gender": "f", "base": "f_bright", "style": "cheerful", "fx": ["high"]}
  }
}
